      "source": [
        "k, m, n = map(int, input().split())\n",
        "\n",
        "total = k + m + n\n",
        "\n",
        "# 자손이 aa가 될 확률\n",
        "p_aa = (\n",
        "    n * (n - 1) / (total * (total - 1))\n",
        "    + m * n / (total * (total - 1))\n",
        "    + m * (m - 1) / (4 * total * (total - 1))\n",
        ")\n",
        "\n",
        "# 우성 표현형이 나타날 확률\n",
        "p_dominant = 1 - p_aa\n",
        "\n",
        "print(p_dominant)"
      ]
    }
  ]
}