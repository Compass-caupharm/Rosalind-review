seqs, name = {}, None
for line in open("rosalind_cons.txt"):
    line = line.strip()
    if line.startswith(">"):
        name = line[1:]
        seqs[name] = ""
    elif line:
        seqs[name] += line

strs = list(seqs.values())
n = len(strs[0])

# 프로파일 행렬: 염기별로 위치마다 개수 세기
profile = {b: [0] * n for b in "ACGT"}
for s in strs:
    for i, b in enumerate(s):
        profile[b][i] += 1

# 컨센서스: 위치마다 개수가 가장 많은 염기
consensus = "".join(max("ACGT", key=lambda b: profile[b][i]) for i in range(n))

print(consensus)
for b in "ACGT":
    print(f"{b}:", *profile[b])
