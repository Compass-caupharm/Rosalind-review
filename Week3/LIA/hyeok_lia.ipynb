   "source": [
    "from scipy.stats import binom\n",
    "\n",
    "data = \"2 1\"                      \n",
    "k, N = map(int, data.split())\n",
    "\n",
    "n = 2 ** k                        # k세대 마리 수\n",
    "p = 0.25                          # 한 마리가 AaBb일 확률\n",
    "\n",
    "답 = binom.sf(N - 1, n, p)    # N-1초과일 확률 \n",
    "print(round(답, 3))"
   ]
  }
 ],
