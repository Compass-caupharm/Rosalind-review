def reverse_translation(protein_seq):
    # 각 아미노산에 대응하는 RNA 코돈의 개수
    codon_counts = {
        'F': 2, 'L': 6, 'S': 6, 'Y': 2, 'C': 2, 'W': 1,
        'P': 4, 'H': 2, 'Q': 2, 'R': 6, 'I': 3, 'M': 1,
        'T': 4, 'N': 2, 'K': 2, 'V': 4, 'A': 4, 'D': 2,
        'E': 2, 'G': 4
    }
    
    MOD = 1_000_000
    # 종결 코돈(Stop codon)의 경우의 수 3으로 초기화
    total_ways = 3
    
    for aa in protein_seq.strip():
        total_ways = (total_ways * codon_counts[aa]) % MOD
        
    return total_ways

# 예제
sample_protein = "MA"
print(reverse_translation(sample_protein))  # 출력: 12
